generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String            @id @default(cuid())
  email               String            @unique
  firstName           String?
  lastName            String?
  password            String
  role                Role              @default(STUDENT)
  lastSeen            DateTime?
  isVerified          Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  applications        Application[]
  advisorAppointments Appointment[]     @relation("AdvisorAppointments")
  studentAppointments Appointment[]     @relation("StudentAppointments")
  assessments         Assessment[]
  documents           Document[]
  immigrationSteps    ImmigrationStep[]
  matchings           Matching[]
  notifications       Notification[]
  profile             Profile?
  subscription        Subscription?
}

model Profile {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  birthDate        DateTime
  gender           Gender
  nationality      String
  phone            String?
  address          String?
  city             String?
  country          String
  highestEducation String?
  experience       Int?
  gpa              Float?
  budget           Float?
  englishLevel     String?
  frenchLevel      String?
  photo            String?
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model University {
  id           String        @id @default(cuid())
  name         String
  countryId    String
  provinceId   String?
  cityId       String?
  website      String?
  ranking      Int?
  description  String?
  logo         String?
  programs     Program[]
  scholarships Scholarship[]
  city         City?         @relation(fields: [cityId], references: [id])
  country      Country       @relation(fields: [countryId], references: [id])
  province     Province?     @relation(fields: [provinceId], references: [id])
}

model Program {
  id           String            @id @default(cuid())
  title        String
  degree       DegreeLevel
  duration     Int
  tuition      Float
  minimumGpa   Float?
  description  String?
  universityId String
  applications Application[]
  matchings    Matching[]
  university   University        @relation(fields: [universityId], references: [id], onDelete: Cascade)
  languages    ProgramLanguage[]
}

model ProgramLanguage {
  id        String  @id @default(cuid())
  language  String
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
}

model Application {
  id         String            @id @default(cuid())
  status     ApplicationStatus @default(DRAFT)
  motivation String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  userId     String
  programId  String
  program    Program           @relation(fields: [programId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
}

model Document {
  id           String       @id @default(uuid())
  originalName String
  filename     String
  filePath     String
  type         DocumentType @default(OTHER)
  isVerified   Boolean      @default(false)
  userId       String
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id])
}

model Matching {
  id             String   @id @default(cuid())
  score          Float
  recommendation String?
  createdAt      DateTime @default(now())
  userId         String
  programId      String
  program        Program  @relation(fields: [programId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
}

model Subscription {
  id        String             @id @default(cuid())
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime
  stripeId  String?
  userId    String             @unique
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ImmigrationStep {
  id                  String             @id @default(cuid())
  title               String
  description         String?
  order               Int
  status              ImmigrationStatus  @default(NOT_STARTED)
  country             String?
  estimatedCost       Float?
  requiredDocs        String[]
  category            String?
  completedAt         DateTime?
  userId              String?
  assessmentRequestId String?
  assessmentRequest   AssessmentRequest? @relation(fields: [assessmentRequestId], references: [id], onDelete: Cascade)
  user                User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType @default(GENERAL)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
}

model Country {
  id           String        @id @default(cuid())
  name         String        @unique
  code         String?
  provinces    Province[]
  scholarships Scholarship[]
  universities University[]
}

model Province {
  id           String       @id @default(cuid())
  name         String
  countryId    String
  cities       City[]
  country      Country      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  universities University[]

  @@unique([name, countryId])
}

model City {
  id           String       @id @default(cuid())
  name         String
  provinceId   String
  province     Province     @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  universities University[]

  @@unique([name, provinceId])
}

model Appointment {
  id          String            @id @default(cuid())
  date        DateTime
  durationMin Int               @default(30)
  status      AppointmentStatus @default(PENDING)
  meetingUrl  String?
  notes       String?
  studentId   String
  advisorId   String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  advisor     User              @relation("AdvisorAppointments", fields: [advisorId], references: [id], onDelete: Cascade)
  student     User              @relation("StudentAppointments", fields: [studentId], references: [id], onDelete: Cascade)
}

model Transaction {
  id           String          @id @default(uuid())
  amount       Float
  currency     String          @default("CAD")
  status       PaymentStatus   @default(PENDING)
  provider     PaymentProvider
  providerTxId String?
  description  String?
  userId       String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Scholarship {
  id           String      @id @default(cuid())
  title        String
  description  String
  amount       Float?
  coverageType String
  deadline     DateTime
  countryId    String
  universityId String?
  link         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  country      Country     @relation(fields: [countryId], references: [id])
  university   University? @relation(fields: [universityId], references: [id])
}

model news {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String?  @default("Information")
  source    String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assessment {
  id                   String             @id @default(uuid())
  createdAt            DateTime           @default(now())
  userId               String?
  assessmentRequestId  String?            @unique
  age                  Int
  educationLevel       DegreeLevel
  workExperienceYrs    Int
  clbFrench            Int
  clbEnglish           Int
  quebecFrenchOral     Int?
  hasQuebecDegree      Boolean            @default(false)
  quebecJobOfferRegion String?
  ontarioHourlyWage    Float?
  isOutsideGTA         Boolean            @default(false)
  ontarioWorkExpYrs    Int                @default(0)
  bcAnnualSalary       Float?
  bcRegionZone         Int?
  hasBcDegree          Boolean            @default(false)
  teerCategory         Int
  hasValidatedOffer    Boolean            @default(false)
  federalEligible      Boolean
  federalCrsScore      Int?
  quebecEligible       Boolean
  ontarioScore         Int?
  bcPnpScore           Int?
  assessmentRequest    AssessmentRequest? @relation(fields: [assessmentRequestId], references: [id], onDelete: Cascade)
  user                 User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssessmentRequest {
  id               String            @id @default(cuid())
  email            String            @unique
  country          String
  fullName         String
  phone            String?
  status           RequestStatus     @default(PENDING)
  accessToken      String?           @unique
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assessment       Assessment?
  immigrationSteps ImmigrationStep[]
}

enum Role {
  STUDENT
  PROFESSIONAL
  ADVISOR
  UNIVERSITY
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  WAITLISTED
}

enum NotificationType {
  STEP_UPDATED
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  GENERAL
}

enum DocumentType {
  PASSPORT
  TRANSCRIPT
  DIPLOMA
  CAQ
  FINANCIAL_PROOF
  OTHER
}

enum ImmigrationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum DegreeLevel {
  HIGH_SCHOOL
  DIPLOMA
  BACHELOR
  MASTER
  PHD
  CERTIFICATE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  MOBILE_MONEY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}
